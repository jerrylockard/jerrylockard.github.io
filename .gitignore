# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# Editor swap and backup files. This matters more than it looks: vim names the
# swap for `.env` as `..env.swp`, which holds that file's unsaved contents and
# matches NEITHER the `.env` rule above nor the pre-commit hook's `.env.*`
# pattern. In a public repo that is a live secret-leak path.
*.swp
*.swo
*.swn
.*.sw[a-p]
*~
*.orig
*.rej

# mcp gui runtime state (pid/log files)
.data/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local Claude Code settings (per-machine, not shared) — except reusable
# skills, which are project tooling, not machine-local config. Tracked
# skills are opted in individually below, same pattern as .remember/'s
# own .gitignore uses for its tracked-vs-runtime split.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/run-jerrylockard-github-io/

# .remember/ has its OWN .gitignore (a blanket `*`, which wins over anything listed
# here for that directory) — the tracked/ignored split for planning docs vs runtime
# memory is defined there, not here. See .remember/.gitignore and .remember/MEMORY.md.

# Playwright MCP tool scratch output (screenshots, page snapshots)
.playwright-mcp/
