---
import { getCollection } from "astro:content";
import Layout from "../layouts/layout.astro";
import Nav from "../components/nav.astro";
import Hero from "../components/hero.astro";
import Catenary from "../components/catenary.astro";
import Strands from "../components/strands.astro";
import Work from "../components/work.astro";
import About from "../components/about.astro";
import Platform from "../components/platform.astro";
import Writing from "../components/writing.astro";
import Footer from "../components/footer.astro";

const recentWriting = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <Nav />
  <main id="top">
    <Hero />
    <Catenary />
    <Strands />
    <Catenary tight />
    <Work />
    <Catenary tight />
    <About />
    <Catenary tight />
    <Platform />
    {
      recentWriting.length > 0 && (
        <>
          <Catenary tight />
          <Writing entries={recentWriting} moreHref="/writing" />
        </>
      )
    }
  </main>
  <Footer />
</Layout>
