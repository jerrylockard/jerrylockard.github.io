---
import { getCollection } from "astro:content";
import Layout from "../../layouts/layout.astro";
import Nav from "../../components/nav.astro";
import Catenary from "../../components/catenary.astro";
import AcademyNoteCard from "../../components/academy-note-card.astro";
import CivicNoteCard from "../../components/civic-note-card.astro";
import JournalEntryCard from "../../components/journal-entry-card.astro";
import Footer from "../../components/footer.astro";

const academyNotes = (await getCollection("academyNotes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.sessionDate.valueOf() - a.data.sessionDate.valueOf(),
);
const civicNotes = (await getCollection("civicNotes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.meetingDate.valueOf() - a.data.meetingDate.valueOf(),
);
const writing = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const hasAny = academyNotes.length > 0 || civicNotes.length > 0 || writing.length > 0;

// Masthead photo for the page header — the most recent Academy note that has
// one set (most won't, yet). Deliberately page-level, not shown on the
// Academy card itself: it isn't from any one session, so pairing it with a
// specific session's date/title misread as "taken that night."
const featured = academyNotes.find((entry) => entry.data.image);
---

<Layout
  title="Notes — Jerry Lockard"
  description="Mayor's Academy sessions, Covington civic meetings, and personal writing — Jerry's first-person notes on public service in Covington, Kentucky, in one place."
>
  <Nav />
  <main id="top">
    <div class="wrap page-header">
      <div class="page-header-text">
        <p class="eyebrow">Notes</p>
        <div class="page-lede">
          <p>
            Covington is where I chose to plant my roots after finishing my B.A. in Political
            Science — and where I'm keeping track of what comes next.
          </p>
          <p>
            This is part personal blog, part notebook, and part record of the city I now call
            home. I write about what I'm learning through the Mayor's Academy, what I hear at
            public meetings, what deserves more attention, what's working, and what I think we
            can do better.
          </p>
          <p>
            I want to remember things as they happened — what bothered me, what gave me hope,
            what raised questions, and what made me think something needed to be brought closer
            to the front.
          </p>
          <p>
            Sometimes that means highlighting good work. Sometimes it means asking uncomfortable
            questions or calling out systems that aren't doing enough for the people they're
            supposed to serve.
          </p>
          <p>I'm still learning, and when I get something wrong, I'll correct it openly.</p>
          <p>
            This notebook isn't the whole plan. One day, I want to serve at the highest levels of
            government. I joke about becoming Speaker of the House, but the ambition is real.
          </p>
          <p>Everybody starts somewhere.</p>
          <p>
            I'm starting here — in Covington, listening, learning, speaking up, and keeping a
            record of the road from here to there.
          </p>
          <p class="page-lede-close">Remember the name.</p>
        </div>
      </div>
      {
        featured?.data.image && (
          <figure class="page-header-photo">
            <img src={featured.data.image} alt={featured.data.imageAlt ?? ""} />
            {featured.data.imageCaption && <figcaption>{featured.data.imageCaption}</figcaption>}
          </figure>
        )
      }
    </div>
    <Catenary tight />

    {!hasAny && (
      <div class="wrap observe">
        <p class="empty-note">Nothing published yet — check back after the next session or meeting.</p>
      </div>
    )}

    {civicNotes.length > 0 && (
      <section class="wrap observe notes-section" id="civic">
        <div class="section-head">
          <p class="eyebrow">Civic Field Notes</p>
        </div>
        <div class="notes-grid">
          {civicNotes.slice(0, 3).map((entry) => <CivicNoteCard entry={entry} />)}
        </div>
        <div class="section-foot">
          <a class="section-link" href="/civic-notes">All civic notes &nbsp;→</a>
        </div>
      </section>
    )}

    {civicNotes.length > 0 && academyNotes.length > 0 && <Catenary tight />}

    {academyNotes.length > 0 && (
      <section class="wrap observe notes-section" id="academy">
        <div class="section-head">
          <p class="eyebrow">Mayor's Academy</p>
          <a class="section-link" href="/academy-notes">All Academy Notes &nbsp;→</a>
        </div>
        <div class="notes-grid">
          {academyNotes.slice(0, 3).map((entry) => <AcademyNoteCard entry={entry} />)}
        </div>
      </section>
    )}

    {(academyNotes.length > 0 || civicNotes.length > 0) && writing.length > 0 && <Catenary tight />}

    {writing.length > 0 && (
      <section class="wrap observe notes-section" id="journal">
        <div class="section-head">
          <p class="eyebrow">Journal</p>
          <a class="section-link" href="/writing">All writing &nbsp;→</a>
        </div>
        <div class="notes-grid">
          {writing.slice(0, 3).map((entry) => <JournalEntryCard entry={entry} />)}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<style>
  .page-header {
    padding-top: 56px;
    padding-bottom: 20px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .page-header-text {
    flex: 1 1 300px;
  }

  .page-header .eyebrow {
    margin-bottom: 8px;
  }

  .page-header-photo {
    flex: 0 0 auto;
    margin: 0;
    width: 340px;
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }

  .page-header-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border: 1px solid var(--rule);
    border-radius: 3px;
  }

  .page-header-photo figcaption {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.4;
    color: var(--ink-faint);
  }

  .page-lede {
    max-width: 54ch;
  }

  .page-lede p {
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .page-lede p.page-lede-close {
    font-style: italic;
    color: var(--ink);
    margin-bottom: 0;
  }

  .notes-section .eyebrow {
    margin-bottom: 0;
  }

  #academy {
    margin-top: 16px;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .section-foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 20px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .section-link {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: border-color 160ms ease;
  }

  .section-link:hover {
    border-bottom-color: var(--accent);
  }

  .empty-note {
    color: var(--ink-faint);
    padding: 24px 0 64px;
  }
</style>
