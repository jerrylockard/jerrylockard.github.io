---
// A summary card for one civic-notes entry — used on the /civic-notes index.
// Status is always shown as visible text, never conveyed by color alone.
import type { CollectionEntry } from "astro:content";
import { STATUS_LABELS, formatMeetingDate } from "../data/civicNotes";

interface Props {
  entry: CollectionEntry<"civicNotes">;
}

const { entry } = Astro.props;
const { title, meetingDate, meetingType, summary, topics, status, attendance, updatedDate } = entry.data;

// The site's approved palette has no red/amber status colors — only accent
// and neutral ink tones. Status is distinguished primarily by its label
// text (never color alone); "active" tone is a secondary visual cue for the
// states still moving, muted for the ones that have stalled or ended.
const STATUS_TONE: Record<typeof status, "active" | "muted"> = {
  proposed: "active",
  "advanced-from-caucus": "active",
  approved: "active",
  implemented: "active",
  deferred: "muted",
  rejected: "muted",
};
---

<a class="civic-card" href={`/civic-notes/${entry.id}`}>
  <div class="civic-card-head">
    <span class={`status-pill is-${STATUS_TONE[status]}`}>{STATUS_LABELS[status]}</span>
    <span class="civic-card-date">{formatMeetingDate(meetingDate)}</span>
  </div>
  <h3 class="civic-card-title">{title}</h3>
  <p class="civic-card-summary">{summary}</p>
  <div class="civic-card-meta">
    <span>{meetingType}</span>
    <span>{attendance === "full" ? "Attended in full" : "Attended in part"}</span>
    <span>Updated {formatMeetingDate(updatedDate)}</span>
  </div>
  {
    topics.length > 0 && (
      <ul class="civic-card-topics">
        {topics.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }
</a>

<style>
  .civic-card {
    display: block;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    transition: padding-left 180ms ease, background-color 180ms ease;
  }

  .civic-card:first-of-type {
    border-top: 1px solid var(--rule);
  }

  .civic-card:hover {
    background: var(--limestone);
    padding-left: 12px;
  }

  .civic-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .status-pill {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 20px;
    border: 1px solid transparent;
  }

  .status-pill.is-active {
    color: var(--accent-ink);
    background: var(--limestone);
    border-color: var(--accent);
  }

  .status-pill.is-muted {
    color: var(--ink-faint);
    background: transparent;
    border-color: var(--rule);
  }

  .civic-card-date {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-faint);
  }

  .civic-card-title {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  .civic-card-summary {
    margin: 0 0 12px;
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.6;
    max-width: 68ch;
  }

  .civic-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    margin-bottom: 10px;
  }

  .civic-card-topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .civic-card-topics li {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    background: var(--limestone);
    border-radius: 3px;
    padding: 3px 8px;
  }
</style>
