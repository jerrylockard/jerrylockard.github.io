---
import { identity } from "../data/site";
---

<section class="wrap hero">
  <div class="hero-grid">
    <div>
      <h1 class="name reveal">{identity.name}</h1>
      <div class="locator reveal">{identity.coordinates} · <span>{identity.location}</span></div>
      <p class="thesis">Different spaces, <em>same instinct</em>: show up, pay attention, and care about who it actually helps.</p>
      <p class="bio">
        I earned my B.A. in Political Science at Eastern Kentucky University and chose Covington
        as the place to plant my roots. Now I'm learning the city through the Mayor's Academy,
        public meetings, community work, and the technology I build along the way. I'm still
        growing, still learning, and just getting started — I hope you'll follow along, and maybe
        we can help make a little change together.
      </p>
      <div class="actions">
        <a class="btn" href="#work">See the work</a>
        <a class="btn btn-quiet" href="#contact">Get in touch</a>
      </div>
    </div>
    <div class="portrait">
      <img src="/PORTRAIT.jpg" alt="Portrait of Jerry Lockard" />
    </div>
  </div>
</section>
