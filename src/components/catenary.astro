---
// Roebling Suspension Bridge — architectural elevation linework.
// Procedural geometry keeps the illustration crisp, responsive and lightweight.
interface Props { tight?: boolean; }
const { tight = false } = Astro.props;

const W = 1200;
const TOWERS = [250, 950];
const FLAG_TOP_Y = 2;
const FINIAL_TOP_Y = 10;
const SADDLE_Y = 20;
const CORNICE_Y = 32;
const STAY_ORIGIN_Y = 30;
const ARCH_APEX_Y = 52;
const ARCH_SPRING_Y = 78;
const DECK_TOP = 88;
const DECK_BOT = 102;
const SOFFIT_Y = 105;
const BANK_Y = 136;
const WATER_Y = 143;
const VIEW_H = tight ? 118 : 168;
const PIER_FOOT = tight ? 116 : WATER_Y;
const SHAFT_HW_TOP = 13.5;
const SHAFT_HW_BASE = 17;
const PIER_HW_TOP = 19;
const PIER_HW_FOOT = tight ? 21 : 24;
const ARCH_HW = 9.5;

const shaftHW = (y: number) => SHAFT_HW_TOP + ((SHAFT_HW_BASE - SHAFT_HW_TOP) * (y - CORNICE_Y)) / (SOFFIT_Y - CORNICE_Y);
const CX = [250, 483, 717, 950];
const CY = [SADDLE_Y, 97, 97, SADDLE_Y];
const bez = (p: number[], t: number) => {
  const u = 1 - t;
  return u * u * u * p[0] + 3 * u * u * t * p[1] + 3 * u * t * t * p[2] + t * t * t * p[3];
};
const cableY = (x: number) => {
  let lo = 0, hi = 1;
  for (let i = 0; i < 32; i += 1) {
    const m = (lo + hi) / 2;
    if (bez(CX, m) < x) lo = m; else hi = m;
  }
  return bez(CY, (lo + hi) / 2);
};
const CABLE = `M${CX[0]},${CY[0]} C${CX[1]},${CY[1]} ${CX[2]},${CY[2]} ${CX[3]},${CY[3]}`;
const CABLE_SECONDARY = `M${CX[0]},${CY[0] + 2.3} C${CX[1]},${CY[1] + 2.1} ${CX[2]},${CY[2] + 2.1} ${CX[3]},${CY[3] + 2.3}`;

const BACKSTAY_EDGE_Y = 112;
const BACKSTAYS = `M${TOWERS[0]},${SADDLE_Y}L0,${BACKSTAY_EDGE_Y}M${TOWERS[1]},${SADDLE_Y}L${W},${BACKSTAY_EDGE_Y}`;
const backstayY = (x: number) => {
  const t = x < TOWERS[0] ? (TOWERS[0] - x) / TOWERS[0] : (x - TOWERS[1]) / (W - TOWERS[1]);
  return SADDLE_Y + (BACKSTAY_EDGE_Y - SADDLE_Y) * t;
};

const HANGER_STEP = tight ? 56 : 28;
let hangers = "";
for (let x = TOWERS[0] + HANGER_STEP; x <= TOWERS[1] - HANGER_STEP; x += HANGER_STEP) hangers += `M${x},${cableY(x).toFixed(1)}V${DECK_TOP}`;
for (let d = HANGER_STEP + 20; d < TOWERS[0]; d += HANGER_STEP + 12) {
  for (const x of [TOWERS[0] - d, TOWERS[1] + d]) {
    const y = backstayY(x);
    if (y < DECK_TOP - 6) hangers += `M${x},${y.toFixed(1)}V${DECK_TOP}`;
  }
}

let stays = "";
for (const t of TOWERS) for (const d of [50, 92, 138, 188]) for (const s of [-1, 1]) {
  const x = t + s * d;
  if (x >= 4 && x <= W - 4) stays += `M${t},${STAY_ORIGIN_Y}L${x},${DECK_TOP}`;
}

const BAY = tight ? 48 : 36;
const inTower = (x: number) => TOWERS.some((t) => Math.abs(x - t) < 25);
let lattice = "";
let posts = "";
for (let x = 0; x + BAY <= W; x += BAY) if (!inTower(x + BAY / 2)) lattice += `M${x},${DECK_TOP}L${x + BAY},${DECK_BOT}M${x},${DECK_BOT}L${x + BAY},${DECK_TOP}`;
for (let x = 0; x <= W; x += BAY) if (!inTower(x)) posts += `M${x},${DECK_TOP}V${DECK_BOT}`;

let towers = "";
let arches = "";
let courses = "";
let caps = "";
let masonryJoints = "";
let towerOpenings = "";
for (const t of TOWERS) {
  towers += `M${t - SHAFT_HW_TOP},${CORNICE_Y}L${t - SHAFT_HW_BASE},${SOFFIT_Y}L${t - PIER_HW_TOP},${SOFFIT_Y}L${t - PIER_HW_FOOT},${PIER_FOOT}H${t + PIER_HW_FOOT}L${t + PIER_HW_TOP},${SOFFIT_Y}L${t + SHAFT_HW_BASE},${SOFFIT_Y}L${t + SHAFT_HW_TOP},${CORNICE_Y}Z`;
  arches += `M${t - ARCH_HW},${DECK_BOT}V${ARCH_SPRING_Y}Q${t - ARCH_HW},${ARCH_SPRING_Y - 17} ${t},${ARCH_APEX_Y}Q${t + ARCH_HW},${ARCH_SPRING_Y - 17} ${t + ARCH_HW},${ARCH_SPRING_Y}V${DECK_BOT}`;
  towerOpenings += `M${t - ARCH_HW + 2.2},${DECK_BOT}V${ARCH_SPRING_Y + 1}Q${t - ARCH_HW + 2.2},${ARCH_SPRING_Y - 13} ${t},${ARCH_APEX_Y + 4}Q${t + ARCH_HW - 2.2},${ARCH_SPRING_Y - 13} ${t + ARCH_HW - 2.2},${ARCH_SPRING_Y + 1}V${DECK_BOT}`;
  caps += `M${t - SHAFT_HW_TOP - 3},${CORNICE_Y}V${CORNICE_Y - 6}H${t + SHAFT_HW_TOP + 3}V${CORNICE_Y}M${t - SHAFT_HW_TOP - 3},${CORNICE_Y - 6}L${t - SHAFT_HW_TOP + .5},${SADDLE_Y}H${t + SHAFT_HW_TOP - .5}L${t + SHAFT_HW_TOP + 3},${CORNICE_Y - 6}`;
  for (const s of [-1, 1]) {
    const fx = t + s * 9.5;
    caps += `M${fx - 2},${SADDLE_Y}V${FINIAL_TOP_Y + 2}L${fx},${FINIAL_TOP_Y}L${fx + 2},${FINIAL_TOP_Y + 2}V${SADDLE_Y}`;
  }
  for (const y of [38, 45]) courses += `M${t - shaftHW(y)},${y}H${t + shaftHW(y)}`;
  courses += `M${t - shaftHW(82)},82H${t - ARCH_HW}M${t + ARCH_HW},82H${t + shaftHW(82)}`;
  if (!tight) for (const y of [113, 122, 131]) {
    const hw = PIER_HW_TOP + ((PIER_HW_FOOT - PIER_HW_TOP) * (y - SOFFIT_Y)) / (PIER_FOOT - SOFFIT_Y);
    courses += `M${t - hw},${y}H${t + hw}`;
  }
  for (const y of [56, 70]) masonryJoints += `M${t - shaftHW(y) + 3},${y}V${y + 4}M${t + shaftHW(y) - 3},${y}V${y + 4}`;
}

const ROAD_RAIL = `M0,84H${W}M0,86H${W}`;
let roadPosts = "";
for (let x = 0; x <= W; x += tight ? 48 : 30) roadPosts += `M${x},84V88`;
const anchorages = tight ? "" : `M18,112V119H48V112M1152,112V119H1182V112`;
let flags = "";
if (!tight) for (const t of TOWERS) flags += `M${t},${FINIAL_TOP_Y + 2}V${FLAG_TOP_Y}L${t + 9},${FLAG_TOP_Y + 3}L${t},${FLAG_TOP_Y + 6}`;

const SKYLINE: Array<[number, number, number, boolean]> = [
  [80,42,14,false],[126,28,20,false],[158,34,12,false],[196,20,30,true],[220,40,16,false],[264,30,23,false],
  [298,36,13,false],[338,26,19,false],[368,50,26,false],[422,24,14,false],[450,34,21,false],[488,22,17,false],
  [514,44,25,false],[562,30,12,false],[596,52,22,false],[652,26,18,false],[682,36,14,false],[722,28,20,false],
  [756,20,33,true],[780,44,16,false],[828,30,24,false],[862,38,13,false],[904,26,28,false],[934,42,15,false],
  [980,30,21,false],[1014,36,25,false],[1054,28,13,false],[1086,44,19,false],
];
let skyline = "";
if (!tight) for (const [x,w,h,spire] of SKYLINE) skyline += spire
  ? `M${x},${BANK_Y}V${BANK_Y-h*.55}L${x+w/2},${BANK_Y-h}L${x+w},${BANK_Y-h*.55}V${BANK_Y}`
  : `M${x},${BANK_Y}V${BANK_Y-h}H${x+w}V${BANK_Y}`;
const RIVER = tight ? "" : `M0,${BANK_Y}H${W}M0,${WATER_Y}H${W}M96,150H352M404,150H628M690,150H902M958,150H1148M52,156H268M330,156H520M600,156H812M884,156H1092M170,161H430M498,161H700M772,161H1010`;
const svgClass = tight ? "span-rule span-rule--tight" : "span-rule";
---

<div class="wrap span-wrap">
  <svg class={svgClass} viewBox={`0 0 ${W} ${VIEW_H}`} aria-hidden="true" focusable="false">
    {!tight && <path class="sr-river" d={RIVER} />}
    {!tight && <path class="sr-skyline" d={skyline} />}
    {!tight && <path class="sr-anchor" d={anchorages} />}
    <path class="sr-stone" d={towers}></path>
    <path class="sr-course" d={courses}></path>
    <path class="sr-joint" d={masonryJoints}></path>
    <path class="sr-arch" d={arches}></path>
    <path class="sr-opening" d={towerOpenings}></path>
    <path class="sr-stone" d={caps}></path>
    {!tight && <path class="sr-flag" d={flags} />}
    <path class="sr-cable sr-cable-main" d={CABLE}></path>
    <path class="sr-cable sr-cable-secondary" d={CABLE_SECONDARY}></path>
    <path class="sr-cable" d={BACKSTAYS}></path>
    <path class="sr-stay" d={stays}></path>
    <path class="sr-hanger" d={hangers}></path>
    <path class="sr-road" d={ROAD_RAIL}></path>
    <path class="sr-road-post" d={roadPosts}></path>
    <path class="sr-lattice" d={lattice}></path>
    <path class="sr-lattice" d={posts}></path>
    <path class="sr-chord" d={`M0,${DECK_TOP}H${W}M0,${DECK_BOT}H${W}M0,${SOFFIT_Y}H${W}`}></path>
  </svg>
</div>

<style>
  .span-rule {
    shape-rendering: geometricPrecision;
  }

  .span-rule path {
    fill: none;
    stroke: var(--ink-faint);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* Drafting hierarchy: structure first, construction lines second, context last. */
  .span-rule .sr-stone,
  .span-rule .sr-arch {
    stroke: var(--accent-ink);
    stroke-width: 1.15;
    opacity: 0.78;
  }

  .span-rule .sr-opening {
    stroke: var(--accent-ink);
    stroke-width: 0.55;
    opacity: 0.36;
  }

  .span-rule .sr-course,
  .span-rule .sr-joint {
    stroke: var(--accent-ink);
    stroke-width: 0.5;
    opacity: 0.26;
  }

  .span-rule .sr-cable-main {
    stroke: var(--accent);
    stroke-width: 1.45;
    opacity: 0.86;
  }

  .span-rule .sr-cable-secondary {
    stroke: var(--accent);
    stroke-width: 0.55;
    opacity: 0.34;
  }

  .span-rule .sr-cable:not(.sr-cable-main):not(.sr-cable-secondary) {
    stroke: var(--accent);
    stroke-width: 0.85;
    opacity: 0.44;
  }

  .span-rule .sr-stay {
    stroke: var(--accent);
    stroke-width: 0.55;
    opacity: 0.30;
  }

  .span-rule .sr-hanger {
    stroke-width: 0.6;
    opacity: 0.30;
  }

  .span-rule .sr-road,
  .span-rule .sr-chord {
    stroke-width: 0.8;
    opacity: 0.48;
  }

  .span-rule .sr-road-post {
    stroke-width: 0.45;
    opacity: 0.24;
  }

  .span-rule .sr-lattice {
    stroke-width: 0.48;
    opacity: 0.22;
  }

  .span-rule .sr-flag,
  .span-rule .sr-anchor {
    stroke: var(--accent);
    stroke-width: 0.65;
    opacity: 0.42;
  }

  .span-rule .sr-skyline {
    stroke-width: 0.55;
    opacity: 0.22;
  }

  .span-rule .sr-river {
    stroke-width: 0.45;
    opacity: 0.18;
  }

  @media (max-width: 620px) {
    .span-rule:not(.span-rule--tight) {
      margin-top: 48px;
    }

    .span-rule .sr-skyline,
    .span-rule .sr-river,
    .span-rule .sr-lattice,
    .span-rule .sr-course,
    .span-rule .sr-joint,
    .span-rule .sr-road-post {
      opacity: 0.12;
    }

    .span-rule .sr-stay {
      opacity: 0.22;
    }
  }
</style>
