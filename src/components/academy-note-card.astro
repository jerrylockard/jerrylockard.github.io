---
// A summary card for one Mayor's Academy session — used on /notes and
// /academy-notes. Shares the civic-note-card's newspaper DNA (serif title,
// mono kicker, hairline rule, hover slide-in) but reads as a dispatch from a
// program with a fixed arc, not a tracked decision — so the kicker is a
// session count ("Session 1 of 8"), not a status. Shows the session photo
// full-bleed at the top when one exists (optional field — most sessions
// won't have one yet) instead of leaving every card pure text.
import type { CollectionEntry } from "astro:content";
import { formatMeetingDate } from "../data/civicNotes";

interface Props {
  entry: CollectionEntry<"academyNotes">;
}

const { entry } = Astro.props;
const { title, sessionNumber, sessionCount, sessionDate, location, speakers, description, image, imageAlt, imageCaption } = entry.data;
---

<a class="academy-card" href={`/academy-notes/${entry.id}`}>
  <div class="academy-card-inner">
    {
      image && (
        <div class="academy-card-photo">
          <img class="academy-card-image" src={image} alt={imageAlt ?? ""} loading="lazy" />
          {imageCaption && <p class="academy-card-caption">{imageCaption}</p>}
        </div>
      )
    }
    <div class="academy-card-body">
      <div class="academy-card-head">
        <span class="session-kicker">Session {sessionNumber} of {sessionCount} · Mayor's Academy</span>
      </div>
      <h3 class="academy-card-title">{title}</h3>
      <p class="academy-card-summary">{description}</p>
      <div class="academy-card-meta">
        <span>{formatMeetingDate(sessionDate)}</span>
        <span>{location}</span>
      </div>
      <p class="academy-card-byline">Featuring {speakers.join(" & ")}</p>
    </div>
  </div>
</a>

<style>
  .academy-card {
    display: block;
    height: 100%;
    background: var(--limestone);
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 180ms ease;
  }

  .academy-card:hover {
    border-color: var(--accent);
  }

  .academy-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 180ms ease;
  }

  .academy-card:hover .academy-card-inner {
    transform: translateX(6px);
  }

  .academy-card-photo {
    position: relative;
  }

  .academy-card-image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
  }

  .academy-card-caption {
    margin: 0;
    padding: 6px 10px;
    background: var(--paper-veil);
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.4;
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
  }

  .academy-card-body {
    padding: 20px;
  }

  .academy-card-head {
    margin-bottom: 8px;
  }

  .session-kicker {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .academy-card-title {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }

  .academy-card-summary {
    margin: 0 0 12px;
    color: var(--ink-soft);
    font-size: 15.5px;
    line-height: 1.6;
    max-width: 68ch;
  }

  .academy-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink-faint);
    margin-bottom: 6px;
  }

  .academy-card-byline {
    margin: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
