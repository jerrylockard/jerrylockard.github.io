#!/usr/bin/env bash
# Refuses to commit secrets or editor-swap files into this PUBLIC repository.
#
# GitHub push rulesets would enforce this server-side, but they are org-only —
# a personal public repo cannot have them (verified 2026-08-26). This hook is
# the local equivalent: it catches the mistake at the moment it would happen,
# on every machine that runs `pnpm install`.
set -uo pipefail

blocked=""
while IFS= read -r file; do
  [ -n "$file" ] || continue
  case "$file" in
    .env.example) continue ;;
    .env|.env.*) blocked="$blocked$file"$'\n' ;;
    # Editor swap/backup files. Vim's swap for `.env` is `..env.swp` — it holds
    # that file's contents and matches neither pattern above, so it needs its own
    # rule rather than relying on .gitignore (which a `git add -f` walks straight
    # past). Force-adding one of these is never deliberate.
    *.swp|*.swo|*.swn|*~|*.orig|*.rej) blocked="$blocked$file"$'\n' ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$blocked" ]; then
  printf '\n\033[1;31mCommit refused — secret-shaped file staged for a PUBLIC repo.\033[0m\n\n'
  printf '%s' "$blocked" | sed 's/^/    /'
  printf '\n  This repository is public. A commit here is permanent: deleting the file\n'
  printf '  later does not remove it from git history.\n\n'
  printf '  Unstage with:  git restore --staged <file>\n\n'
  exit 1
fi
