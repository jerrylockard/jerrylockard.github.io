---
// Résumé link only renders once public/resume.pdf actually exists — drop the
// file there (repo root: public/resume.pdf) and it appears automatically on
// the next build, same pattern nav.astro uses for hasWriting/hasCivicNotes.
import { existsSync } from "node:fs";
import { join } from "node:path";
import { identity } from "../data/site";

// process.cwd()-based, not import.meta.url-based: Astro/Vite doesn't resolve
// import.meta.url to this file's real source path once it's bundled, but the
// build always runs from the project root, so this is the reliable check.
const hasResume = existsSync(join(process.cwd(), "public", "resume.pdf"));
---

<footer class="footer" id="contact">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h2>If any of this is useful to you, say hello.</h2>
        <p class="footer-note">
          I'm especially interested in community, program, and policy work here in Northern
          Kentucky. I answer everything.
        </p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${identity.email}`}>{identity.email}</a>
        <a href={identity.linkedin}>LinkedIn</a>
        <a href={identity.github}>GitHub</a>
        {hasResume && <a href="/resume.pdf">Résumé (PDF)</a>}
      </div>
    </div>
    <div class="colophon">
      <span>Covington, Kentucky</span>
      <span>Newsreader · Public Sans · IBM Plex Mono</span>
      <span>Self-hosted</span>
    </div>
  </div>
</footer>
