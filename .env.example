# Copy to .env and fill in. .env is gitignored; this file is not.
# Agents are blocked from reading .env at the tool layer (mcp/agents/src/tools.ts).

# ---- agents ----
# One key covers Anthropic/OpenAI/Google via the Vercel AI Gateway.
# Without it the dashboard still runs; agent turns report the missing key in-chat.
AI_GATEWAY_API_KEY=

# ---- dashboard auth ----
# Required to start the dashboard at all, on loopback included — see
# mcp/gui/server/security.ts. Use a long random passphrase, not a memorable one;
# this gates shell access to the repo.
DASHBOARD_PASSWORD=
DASHBOARD_USER=jerry

# Escape hatch for running unauthenticated on 127.0.0.1 while hacking locally.
# Without a password AND without this, the server refuses to start — binding to
# loopback does not prove nobody else can reach you (a tunnel or a forwarded port
# is invisible from inside the process), so auth is the default rather than
# something switched on when exposure is detected.
# This never permits exposure: with HOST or DASHBOARD_PUBLIC_ORIGIN set, a real
# password is still required. Leave it unset on any machine you tunnel from.
# DASHBOARD_ALLOW_NO_AUTH=1

# Signs session cookies. Optional: one is generated per boot if unset, which is
# safe but logs you out on every restart. Pin it to stay signed in across restarts:
#   openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# ---- remote access (Cloudflare Tunnel) ----
# Set ONLY when serving through the tunnel. Turns on Secure cookies, HSTS, and
# lets same-origin checks accept the public hostname.
# DASHBOARD_PUBLIC_ORIGIN=https://dashboard.jerrylockard.me

# ---- email digests (optional) ----
# The agents report to you by email once a day. They do NOT get a send-mail tool:
# they keep writing team updates, and the SERVER sends. That keeps SMTP credentials
# out of the agent loop (agents can read .env through their Bash tool) and means
# DIGEST_TO is the only possible recipient — a misbehaving agent can fill your own
# inbox but can never mail someone else as you.
#
# IONOS: host smtp.ionos.com, port 465, authenticating as a real mailbox.
# All four must be set, or the digest stays off and says so on boot.
# SMTP_HOST=smtp.ionos.com
# SMTP_PORT=465
# SMTP_USER=jerry@lockard.me
# SMTP_PASSWORD=
# DIGEST_TO=jerry@lockard.me
# Local hour to send, 0-23. Default 8.
# DIGEST_HOUR=8
# Optional From override. Must be an address IONOS lets this account send as.
# SMTP_FROM=jerry@lockard.me
