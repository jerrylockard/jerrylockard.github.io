# build output
dist/
# generated types
.astro/
# Firebase CLI's local deploy cache (per-machine, not shared)
.firebase/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# Editor swap and backup files. This matters more than it looks: vim names the
# swap for `.env` as `..env.swp`, which holds that file's unsaved contents and
# matches NEITHER the `.env` rule above nor the pre-commit hook's `.env.*`
# pattern. In a public repo that is a live secret-leak path.
*.swp
*.swo
*.swn
.*.sw[a-p]
*~
*.orig
*.rej

# mcp gui runtime state (pid/log files)
.data/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local Claude Code settings (per-machine, not shared) — except reusable
# skills, which are project tooling, not machine-local config, and
# settings.json, which carries a project-wide .env-read deny rule that applies
# regardless of which tool/session is working in this repo — that one's shared
# config, not machine-local, so it's tracked like the skills below it.
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/run-jerrylockard-github-io/

# Playwright MCP tool scratch output (screenshots, page snapshots)
.playwright-mcp/

# Private working notes explicitly excluded from git by Jerry (2026-08-29) — a
# one-time, meeting-specific exception to the marriage/divorce exclusion in
# docs/GUARDRAILS.md. Never remove this line or reference this file from a
# tracked doc; see the file's own header for the full scope of the exception.
docs/research/civic-notes/dv-epo-analysis-2026-08-25.md
