---
import { getCollection } from "astro:content";
import Layout from "../layouts/layout.astro";
import Nav from "../components/nav.astro";
import Hero from "../components/hero.astro";
import Catenary from "../components/catenary.astro";
import Work from "../components/work.astro";
import About from "../components/about.astro";
import Platform from "../components/platform.astro";
import Writing from "../components/writing.astro";
import Footer from "../components/footer.astro";

const recentWriting = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <Nav />
  <main id="top">
    <div class="hero-screen">
      <Hero />
      <Catenary />
    </div>
    <About />
    <Catenary tight />
    <Platform />
    <Catenary tight />
    <Work />
    {
      recentWriting.length > 0 && (
        <>
          <Catenary tight />
          <Writing entries={recentWriting} moreHref="/writing" />
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  /* The hero and bridge together form the opening composition; don't force
     the hero to fill the viewport, which pushes the separator away from the portrait. */
  .hero-screen {
    width: 100%;
  }

  .hero-screen :global(.hero) {
    width: 100%;
  }

  .hero-screen :global(.hero-grid) {
    width: 100%;
  }
</style>
