---
import { getCollection } from "astro:content";
import Layout from "../../layouts/layout.astro";
import Nav from "../../components/nav.astro";
import Catenary from "../../components/catenary.astro";
import Writing from "../../components/writing.astro";
import Footer from "../../components/footer.astro";

const entries = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Writing — Jerry Lockard" description="Notes on Covington, public service, and the Mayor's Academy, written up as I go.">
  <Nav />
  <main id="top">
    <div class="wrap page-header">
      <p class="eyebrow">Writing</p>
      <p class="page-lede">Notes on Covington, public service, and the Mayor's Academy, written up as I go.</p>
    </div>
    <Catenary tight />
    {
      entries.length > 0 ? (
        <Writing entries={entries} heading="All writing" />
      ) : (
        <div class="wrap observe">
          <p class="empty-note">Nothing published yet — check back soon.</p>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .page-header {
    padding-top: 56px;
  }

  .page-header .eyebrow {
    margin-bottom: 8px;
  }

  .page-lede {
    font-family: var(--display);
    font-size: 1.22rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: var(--measure);
    margin: 0 0 8px;
  }

  .empty-note {
    color: var(--ink-faint);
    padding: 24px 0 64px;
  }
</style>
