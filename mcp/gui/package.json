{
  "name": "mcp-gui",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "build:css": "pnpm build:icons && tailwindcss -i styles/app.css -o public/app.css --minify",
    "watch:css": "pnpm build:icons && tailwindcss -i styles/app.css -o public/app.css --watch",
    "start": "node scripts/ctl.mjs start",
    "stop": "node scripts/ctl.mjs stop",
    "status": "node scripts/ctl.mjs status",
    "logs": "node scripts/ctl.mjs logs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "ai": "^7.0.77",
    "express": "^5.1.0",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "lucide-static": "1.35.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
