---
// Roebling Suspension Bridge — hand-drawn architectural elevation.
// The geometry is intentionally clean underneath a subtle ink-sketch treatment:
// doubled construction lines, irregular stone courses, and a very light
// displacement make it feel illustrated rather than like a pictogram.
interface Props { tight?: boolean; }
const { tight = false } = Astro.props;

const W = 1400;
const H = tight ? 155 : 225;
const LEFT = 270;
const RIGHT = 1130;
const DECK = 138;
const DECK_LOW = 148;
const WATER = 188;
const BANK = 176;
const TOWER_TOP = 31;
const ARCH_TOP = 74;
const ARCH_SPRING = 104;
const PIER_BOTTOM = 188;

const bez = (p: number[], t: number) => {
  const u = 1 - t;
  return u ** 3 * p[0] + 3 * u * u * t * p[1] + 3 * u * t * t * p[2] + t ** 3 * p[3];
};
const cableY = (x: number) => {
  const span = RIGHT - LEFT;
  const t = (x - LEFT) / span;
  return bez([TOWER_TOP, 77, 77, TOWER_TOP], t);
};
const outerCableY = (x: number) => x < LEFT
  ? TOWER_TOP + ((LEFT - x) / LEFT) * (DECK - TOWER_TOP - 8)
  : TOWER_TOP + ((x - RIGHT) / (W - RIGHT)) * (DECK - TOWER_TOP - 8);

let suspenders = "";
if (!tight) {
  for (let x = LEFT + 30; x < RIGHT; x += 30) {
    suspenders += `M${x},${cableY(x).toFixed(1)}V${DECK}`;
  }
} else {
  for (let x = LEFT + 55; x < RIGHT; x += 55) {
    suspenders += `M${x},${cableY(x).toFixed(1)}V${DECK}`;
  }
}

let stays = "";
for (const t of [LEFT, RIGHT]) {
  for (const d of [52, 96, 142, 192, 244]) {
    const x = t === LEFT ? t + d : t - d;
    if (x > 10 && x < W - 10) stays += `M${t},${TOWER_TOP + 10}L${x},${DECK}`;
  }
}

let truss = "";
const step = tight ? 50 : 34;
for (let x = 0; x < W; x += step) {
  const next = Math.min(W, x + step);
  if (Math.abs((x + next) / 2 - LEFT) > 46 && Math.abs((x + next) / 2 - RIGHT) > 46) {
    truss += `M${x},${DECK}L${next},${DECK_LOW}M${x},${DECK_LOW}L${next},${DECK}`;
  }
}

let verticals = "";
for (let x = 0; x <= W; x += step) {
  if (Math.abs(x - LEFT) > 46 && Math.abs(x - RIGHT) > 46) verticals += `M${x},${DECK}V${DECK_LOW}`;
}

let towers = "";
let arches = "";
let stone = "";
let towerDetails = "";
for (const t of [LEFT, RIGHT]) {
  // Twin masonry shafts with battered bases and a broad cornice.
  towers += `M${t - 27},${TOWER_TOP + 12}L${t - 30},${DECK_LOW}L${t - 43},${PIER_BOTTOM}H${t + 43}L${t + 30},${DECK_LOW}L${t + 27},${TOWER_TOP + 12}Z`;
  towers += `M${t - 9},${TOWER_TOP + 12}V${DECK_LOW}M${t + 9},${TOWER_TOP + 12}V${DECK_LOW}`;
  // Two-centred masonry portal, with a second lighter line for depth.
  arches += `M${t - 18},${DECK_LOW}V${ARCH_SPRING}Q${t - 18},${ARCH_TOP} ${t},${ARCH_TOP}Q${t + 18},${ARCH_TOP} ${t + 18},${ARCH_SPRING}V${DECK_LOW}`;
  arches += `M${t - 14},${DECK_LOW}V${ARCH_SPRING + 4}Q${t - 14},${ARCH_TOP + 7} ${t},${ARCH_TOP + 7}Q${t + 14},${ARCH_TOP + 7} ${t + 14},${ARCH_SPRING + 4}V${DECK_LOW}`;
  // Irregular courses rather than perfectly repeated computer lines.
  for (const y of [45, 55, 66, 79, 92, 108, 122]) {
    const half = 27 - Math.max(0, y - 45) * 0.015;
    stone += `M${t - half},${y}H${t + half}`;
  }
  // Short staggered joints give the limestone a hand-drafted texture.
  for (const y of [49, 60, 73, 86, 99, 114, 128]) {
    const half = 25;
    const offset = (y % 2) * 8;
    towerDetails += `M${t - half + offset},${y}V${y + 5}M${t + half - offset},${y}V${y + 5}`;
  }
  // Cornice, cap, finials and flag mast.
  towers += `M${t - 34},${TOWER_TOP + 12}H${t + 34}M${t - 31},${TOWER_TOP + 7}H${t + 31}M${t - 22},${TOWER_TOP + 7}L${t - 19},${TOWER_TOP}H${t - 7}L${t - 4},${TOWER_TOP + 7}M${t + 4},${TOWER_TOP + 7}L${t + 7},${TOWER_TOP}H${t + 19}L${t + 22},${TOWER_TOP + 7}`;
  towers += `M${t},${TOWER_TOP}V${tight ? TOWER_TOP - 7 : 2}`;
  if (!tight) towers += `M${t},6L${t + 14},10L${t},14`;
}

const CABLE = `M0,${DECK - 9}C${LEFT - 92},${DECK - 28} ${LEFT - 45},${TOWER_TOP + 16} ${LEFT},${TOWER_TOP}C${LEFT + 220},${DECK - 56} ${RIGHT - 220},${DECK - 56} ${RIGHT},${TOWER_TOP}C${RIGHT + 45},${TOWER_TOP + 16} ${RIGHT + 92},${DECK - 28} ${W},${DECK - 9}`;
const CABLE_2 = `M0,${DECK - 5}C${LEFT - 92},${DECK - 24} ${LEFT - 45},${TOWER_TOP + 20} ${LEFT},${TOWER_TOP + 4}C${LEFT + 220},${DECK - 52} ${RIGHT - 220},${DECK - 52} ${RIGHT},${TOWER_TOP + 4}C${RIGHT + 45},${TOWER_TOP + 20} ${RIGHT + 92},${DECK - 24} ${W},${DECK - 5}`;
const BACKSTAYS = `M${LEFT},${TOWER_TOP}L72,${DECK - 7}M${RIGHT},${TOWER_TOP}L${W - 72},${DECK - 7}`;
const DECK_LINES = `M0,${DECK}H${W}M0,${DECK_LOW}H${W}M0,${DECK_LOW + 4}H${W}`;
const PIERS = `M${LEFT - 43},${DECK_LOW}L${LEFT - 36},${PIER_BOTTOM}M${LEFT + 43},${DECK_LOW}L${LEFT + 36},${PIER_BOTTOM}M${RIGHT - 43},${DECK_LOW}L${RIGHT - 36},${PIER_BOTTOM}M${RIGHT + 43},${DECK_LOW}L${RIGHT + 36},${PIER_BOTTOM}`;

const skylineParts = [
  [35, 31, 16], [78, 26, 22], [118, 42, 13], [165, 30, 27], [210, 44, 18], [330, 32, 21],
  [374, 46, 14], [430, 29, 26], [474, 39, 17], [526, 30, 22], [574, 47, 14], [626, 34, 25],
  [684, 43, 16], [733, 31, 21], [782, 44, 14], [835, 29, 25], [880, 46, 16], [934, 32, 23],
  [1000, 42, 15], [1052, 31, 22], [1096, 46, 14], [1194, 34, 21], [1240, 44, 16], [1292, 36, 24], [1340, 40, 14],
];
let skyline = "";
if (!tight) {
  for (const [x, w, h] of skylineParts) skyline += `M${x},${BANK}V${BANK - h}H${x + w}V${BANK}`;
  skyline += `M184,${BANK}V${BANK - 38}L199,${BANK - 55}L214,${BANK - 38}V${BANK}M1168,${BANK}V${BANK - 33}L1182,${BANK - 51}L1196,${BANK - 33}V${BANK}`;
}
const RIVER = tight ? "" : `M0,${BANK}H${W}M0,${WATER}H${W}M40,198H310M365,198H600M665,198H910M970,198H1250M120,208H420M520,208H770M880,208H1170`;
const cls = tight ? "span-rule span-rule--tight" : "span-rule";
---

<div class="wrap span-wrap">
  <svg class={cls} viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <defs>
      <filter id="ink-wobble" x="-3%" y="-6%" width="106%" height="112%">
        <feTurbulence type="fractalNoise" baseFrequency="0.018 0.12" numOctaves="2" seed="17" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.85" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>

    {!tight && <path class="sr-river" d={RIVER} />}
    {!tight && <path class="sr-skyline" d={skyline} />}
    <g filter="url(#ink-wobble)">
      <path class="sr-pier" d={PIERS} />
      <path class="sr-stone" d={towers} />
      <path class="sr-arch" d={arches} />
      <path class="sr-stone-detail" d={stone} />
      <path class="sr-joint" d={towerDetails} />
      <path class="sr-cable" d={CABLE} />
      <path class="sr-cable-secondary" d={CABLE_2} />
      <path class="sr-stay" d={BACKSTAYS} />
      <path class="sr-stay" d={stays} />
      <path class="sr-hanger" d={suspenders} />
      <path class="sr-deck" d={DECK_LINES} />
      <path class="sr-truss" d={truss} />
      <path class="sr-post" d={verticals} />
    </g>

    <!-- A second, lighter pass is the visual trick that makes the ink feel hand-set. -->
    <g class="sr-ghost" transform="translate(0.7 0.35)">
      <path d={CABLE_2} />
      <path d={DECK_LINES} />
      <path d={truss} />
      <path d={suspenders} />
    </g>
  </svg>
</div>

<style>
  .span-rule {
    display: block;
    width: 100%;
    height: auto;
    margin: 42px 0 18px;
    overflow: visible;
    shape-rendering: geometricPrecision;
  }

  .span-rule--tight {
    width: 78%;
    max-width: 920px;
    margin: 58px auto 48px;
  }

  .span-rule path {
    fill: none;
    stroke: var(--ink-faint);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .span-rule .sr-stone,
  .span-rule .sr-arch,
  .span-rule .sr-pier {
    stroke: var(--ink);
    stroke-width: 1.15;
    opacity: 0.72;
  }

  .span-rule .sr-arch {
    stroke-width: 1.35;
  }

  .span-rule .sr-stone-detail,
  .span-rule .sr-joint {
    stroke: var(--ink-soft);
    stroke-width: 0.48;
    opacity: 0.42;
  }

  .span-rule .sr-cable {
    stroke: var(--ink);
    stroke-width: 1.05;
    opacity: 0.68;
  }

  .span-rule .sr-cable-secondary {
    stroke: var(--ink-soft);
    stroke-width: 0.48;
    opacity: 0.42;
  }

  .span-rule .sr-stay {
    stroke: var(--ink-soft);
    stroke-width: 0.48;
    opacity: 0.38;
  }

  .span-rule .sr-hanger {
    stroke: var(--ink-soft);
    stroke-width: 0.48;
    opacity: 0.34;
  }

  .span-rule .sr-deck {
    stroke: var(--ink);
    stroke-width: 0.8;
    opacity: 0.64;
  }

  .span-rule .sr-truss {
    stroke: var(--ink-soft);
    stroke-width: 0.48;
    opacity: 0.46;
  }

  .span-rule .sr-post {
    stroke: var(--ink-soft);
    stroke-width: 0.42;
    opacity: 0.32;
  }

  .span-rule .sr-skyline {
    stroke: var(--ink-faint);
    stroke-width: 0.5;
    opacity: 0.25;
  }

  .span-rule .sr-river {
    stroke: var(--ink-faint);
    stroke-width: 0.45;
    opacity: 0.20;
  }

  .span-rule .sr-ghost path {
    stroke: var(--ink-faint);
    stroke-width: 0.42;
    opacity: 0.17;
  }

  @media (max-width: 700px) {
    .span-rule:not(.span-rule--tight) {
      margin-top: 34px;
      margin-bottom: 6px;
    }

    .span-rule .sr-skyline,
    .span-rule .sr-river,
    .span-rule .sr-stone-detail,
    .span-rule .sr-joint,
    .span-rule .sr-ghost {
      display: none;
    }
  }
</style>
