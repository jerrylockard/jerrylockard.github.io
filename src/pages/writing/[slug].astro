---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/layout.astro";
import Nav from "../../components/nav.astro";
import Footer from "../../components/footer.astro";

export async function getStaticPaths() {
  const entries = await getCollection("writing", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, tag, description } = entry.data;
const formattedDate = date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Layout title={`${title} — Jerry Lockard`} description={description}>
  <Nav />
  <main id="top">
    <article class="wrap post observe">
      <a class="back-link" href="/writing">← All writing</a>
      <p class="post-meta">{formattedDate} · {tag}</p>
      <h1 class="post-title">{title}</h1>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .post {
    padding: 48px 0 80px;
    max-width: calc(var(--measure) + 64px);
  }

  .back-link {
    display: inline-block;
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    text-decoration: none;
    margin-bottom: 28px;
    transition: color 160ms ease;
  }

  .back-link:hover {
    color: var(--accent-ink);
  }

  .post-meta {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin: 0 0 10px;
  }

  .post-title {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 40px;
    max-width: 20ch;
  }

  .prose {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .prose :global(p) {
    margin: 0 0 22px;
    font-size: 17px;
    line-height: 1.75;
  }

  .prose :global(h2) {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.6rem;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin: 44px 0 16px;
  }

  .prose :global(h3) {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.28rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 36px 0 14px;
  }

  .prose :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms ease;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 22px;
    padding-left: 22px;
    line-height: 1.75;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding-left: 18px;
    border-left: 2px solid var(--accent);
    color: var(--ink-soft);
    font-style: italic;
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--limestone);
    border-radius: 3px;
    padding: 0.15em 0.4em;
  }

  .prose :global(pre) {
    background: var(--limestone);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 16px 18px;
    overflow-x: auto;
    margin: 0 0 22px;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 40px 0;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: 4px;
    margin: 8px 0 22px;
  }
</style>
