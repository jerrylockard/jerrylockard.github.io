---
import { getCollection } from "astro:content";

const hasWriting = (await getCollection("writing", ({ data }) => !data.draft)).length > 0;
const hasCivicNotes = (await getCollection("civicNotes", ({ data }) => !data.draft)).length > 0;
const hasAcademyNotes = (await getCollection("academyNotes", ({ data }) => !data.draft)).length > 0;
const hasNotes = hasWriting || hasCivicNotes || hasAcademyNotes;
---

<nav class="nav">
  <div class="wrap nav-inner">
    <a class="nav-mark" href="#top" aria-label="Back to top">JL</a>
    <div class="nav-right">
      <div class="nav-links">
        <a href="/#about">About</a>
        <a href="/#platform">Platform</a>
        <a href="/#work">Work</a>
        {hasNotes && <a href="/notes">Notes</a>}
        <a href="/#contact">Contact</a>
      </div>
      <button class="theme-btn" id="theme-btn" type="button" aria-live="polite">Dark</button>
    </div>
  </div>
</nav>
