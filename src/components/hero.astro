---
import { identity } from "../data/site";
---

<section class="wrap hero">
  <div class="hero-grid">
    <div>
      <h1 class="name reveal">{identity.name}</h1>
      <div class="locator reveal">{identity.coordinates} · <span>{identity.location}</span></div>
      <p class="thesis">I'm learning how my city <em>actually works</em>, and who it works for.</p>
      <p class="bio">
        Political science at EKU, now in the Covington Mayor's Academy. I've served meals at a
        shelter, taught in public school classrooms, and I do the technical work that keeps
        things running quietly in the background.
      </p>
      <div class="actions">
        <a class="btn" href="#work">See the work</a>
        <a class="btn btn-quiet" href="#contact">Get in touch</a>
      </div>
    </div>
    <div class="portrait">PORTRAIT<br />goes here</div>
  </div>
</section>
